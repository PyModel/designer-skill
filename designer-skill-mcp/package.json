{
  "name": "@pymodel/designer-skill-mcp",
  "version": "0.20.0",
  "mcpName": "io.github.PyModel/designer-skill-mcp",
  "description": "Plug-and-play MCP that gives your coding agent UI superpowers: design tools, reference docs, and anti-slop checks.",
  "type": "module",
  "bin": {
    "designer-skill-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "assets/skill",
    "assets/ux-designer",
    "assets/engine",
    "README.md"
  ],
  "scripts": {
    "sync-skill": "node scripts/sync-skill.mjs",
    "build": "npm run sync-skill && tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test && node scripts/smoke-tarball.mjs",
    "smoke": "npm run build && node scripts/smoke-tarball.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design",
    "frontend",
    "ui",
    "designer-skill",
    "agent",
    "coding-agent",
    "plug-and-play"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyModel/designer-skill.git",
    "directory": "designer-skill-mcp"
  },
  "homepage": "https://github.com/PyModel/designer-skill#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "css-select": "^6.0.0",
    "css-tree": "^3.2.1",
    "express": "^5.2.1",
    "htmlparser2": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "ajv": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
